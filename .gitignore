# ==============================================================================
# Artistry Academia - Root .gitignore
# Monorepo: Client (Vite + React) & Server (Express + Node.js + MongoDB)
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment Variables & Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local
server/.env
server/.env.*
client/.env
client/.env.*
_user_credintial.txt
*.pem
*.key

# Build & Output Artifacts
dist/
dist-ssr/
client/dist/
server/dist/
build/
out/

# Deployment & Hosting Cache
.vercel/
server/.vercel/
.firebase/
client/.firebase/
*.cache

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test & Coverage Outputs
coverage/
*.lcov
.nyc_output/

# Editor & OS Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary & Cache Directories
.eslintcache
.stylelintcache
*.tsbuildinfo
scratch/
tmp/
temp/
